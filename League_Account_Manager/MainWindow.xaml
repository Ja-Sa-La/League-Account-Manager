<Window
    WindowStyle="None"
    x:Class="League_Account_Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:shell="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:notifications="clr-namespace:Notification.Wpf"
    mc:Ignorable="d"
    Title="League Account Manager" Height="800" Width="1500"
    AllowsTransparency="True" ResizeMode="CanResize" SizeChanged="MainWindow_OnSizeChanged"
    xmlns:Page="clr-namespace:League_Account_Manager.views"
    Background="#FF232323">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="8" CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid
            x:Name="RootMainGrid"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" Height="800" Width="1500">

            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <Label Content="" Name="installloc" HorizontalAlignment="Left" Margin="450,3,0,0"
                   VerticalAlignment="Top"
                   Width="489" Height="22" />
            <Label Content="" Name="installloclea" HorizontalAlignment="Left" Margin="450,25,0,0"
                   VerticalAlignment="Top"
                   Width="489" Height="22" />
            <TextBox Text="" HorizontalAlignment="Left" Height="22" Margin="939,3,0,0" Name="leaguedata"
                     VerticalAlignment="Top" Width="380" Background="Transparent" Foreground="White">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="IsReadOnly" Value="True" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBox Text="" HorizontalAlignment="Left" Height="22" Margin="939,25,0,0" Name="riotdata"
                     VerticalAlignment="Top" Width="380" Foreground="White" Background="Transparent">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="IsReadOnly" Value="True" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </TextBox.Style>
            </TextBox>
            <ui:NavigationView Grid.Row="1" OpenPaneLength="175" IsBackButtonVisible="Collapsed" MinWidth="50"
                               x:Name="RootNavigation" Grid.Column="0" Loaded="RootNavigation_OnLoaded">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem NavigationCacheMode="Required" Content="League" TargetPageTag="home"
                                           TargetPageType="{x:Type Page:Accounts}">
                        <ui:NavigationViewItem.Icon>
                            <ui:ImageIcon Width="20" Height="20"
                                          Source="pack://application:,,,/Assests/Navigation Icons/League.png" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem NavigationCacheMode="Required" Content="Valorant"
                                           TargetPageType="{x:Type Page:ValorantAccounts}">
                        <ui:NavigationViewItem.Icon>
                            <ui:ImageIcon Width="20" Height="20"
                                          Source="pack://application:,,,/Assests/Navigation Icons/Valorant.png" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Add accounts" TargetPageType="{x:Type Page:AddAccounts}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="AddSquareMultiple20" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Champion select" TargetPageType="{x:Type Page:ChampionSelect}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Group20" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Auto Champ select" NavigationCacheMode="Required"
                                           TargetPageType="{x:Type Page:Autolobby}">
                        <ui:NavigationViewItem.Icon>
                            <ui:ImageIcon Width="20" Height="20"
                                          Source="pack://application:,,,/Assests/Navigation Icons/Auto Champ Select.png" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Buy champions" TargetPageType="{x:Type Page:ChampionBuyer}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Money20" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Report tool" TargetPageType="{x:Type Page:ReportTool}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="BookExclamationMark20" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Misc" TargetPageType="{x:Type Page:MiscTools}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="AppGeneric20" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Chat" NavigationCacheMode="Required"
                                           TargetPageType="{x:Type Page:ProfileEditor}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Chat20" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Loot"
                                           TargetPageType="{x:Type Page:DisEnchanter}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ShoppingBag20" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Ingame settings"
                                           TargetPageType="{x:Type Page:SettingsEditor}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="EditSettings20" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>

                    <Label Height="20" x:Name="version" Content="Version" HorizontalAlignment="Left"
                           Foreground="#80FFFFFF"
                           Padding="15,0,0,4" />
                    <Label Height="20" x:Name="Credits" Content="By Ja-Sa-La" HorizontalAlignment="Left"
                           Foreground="#80FFFFFF"
                           Padding="15,0,0,4" />
                    <ui:NavigationViewItem Click="Discord_OnClick">
                        <ui:NavigationViewItem.Icon>
                            <ui:ImageIcon Width="20" Height="20"
                                          Source="pack://application:,,,/Assests/Navigation%20Icons/Discord.png" />
                        </ui:NavigationViewItem.Icon>
                        <ui:NavigationViewItem.Content>
                            <TextBlock>
                                <Run Text="Join Discord" />
                                <LineBreak />
                                <Run Text="for Support" />
                            </TextBlock>
                        </ui:NavigationViewItem.Content>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type Page:Settings}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
            <ui:TitleBar Grid.Column="1"
                         Title="League Account Manager" Grid.ColumnSpan="2"
                         Grid.Row="0" FontFamily="Arial Black" FontSize="20" Height="31" Focusable="True"
                         ShowMaximize="True"
                         CanMaximize="True" Padding="0,0,0,0" Margin="10,0,0,0" />
            <notifications:NotificationHost Grid.Column="1"
                                    x:Name="WindowArea"
                                    Grid.ColumnSpan="2"
                                    Grid.RowSpan="2"
                                    Width="430"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="True" />

                            <Grid x:Name="UpdateModalOverlay"
                              Grid.RowSpan="2"
                              Grid.ColumnSpan="2"
                              Panel.ZIndex="20"
                              Visibility="Collapsed"
                              Background="Transparent">
                            <Border x:Name="UpdateModalBackdrop"
                                Background="#99000000"
                                Opacity="1"
                                Visibility="Visible" />
                            <Border Width="560"
                                MaxHeight="680"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#FF202124"
                                BorderBrush="#FF4C9AFF"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="UpdateModalTitle"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="Update available" />
                                <TextBlock x:Name="UpdateModalVersion"
                                       Grid.Row="1"
                                       Margin="0,6,0,16"
                                       Foreground="#FFB7C9E8"
                                       FontSize="14" />
                                <ScrollViewer Grid.Row="2"
                                          MaxHeight="430"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="UpdateModalPatchNotes"
                                           TextWrapping="Wrap"
                                           Foreground="#FFE8E8E8"
                                           FontSize="14" />
                                </ScrollViewer>
                                <StackPanel Grid.Row="3"
                                        Margin="0,22,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                    <Button x:Name="UpdateModalLater"
                                        Content="Later"
                                        Click="UpdateModalLater_Click"
                                        MinWidth="90"
                                        Margin="0,0,8,0"
                                        Padding="12,7" />
                                    <Button x:Name="UpdateModalRelease"
                                        Content="Open release"
                                        Click="UpdateModalRelease_Click"
                                        MinWidth="110"
                                        Margin="0,0,8,0"
                                        Padding="12,7" />
                                    <Button x:Name="UpdateModalUpdate"
                                        Content="Update now"
                                        Click="UpdateModalUpdate_Click"
                                        MinWidth="110"
                                        Padding="12,7"
                                        IsDefault="True" />
                                </StackPanel>
                                </Grid>
                            </Border>
                            </Grid>

        </Grid>
    </Viewbox>
</Window>