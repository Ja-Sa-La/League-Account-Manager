<Page x:Class="League_Account_Manager.views.ValorantLoadout"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="749" d:DesignWidth="1216"
      Title="Valorant loadout">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Valorant loadout" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="View the skins equipped on the signed-in account and switch each weapon to another skin that account owns."
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Refresh" Click="OnRefreshClick" Margin="0,0,8,0" MinWidth="100" />
                <ui:Button Content="Apply changes" Click="OnApplyChangesClick" Margin="0,0,8,0" MinWidth="120" />
                <ui:Button Content="Save for agent" Click="OnSaveForAgentClick" Margin="0,0,8,0" MinWidth="130" />
                <ui:Button Content="Reset agent" Click="OnResetAgentClick" Margin="0,0,8,0" MinWidth="110" />
                <ui:Button Content="Save as set" Click="OnSaveSetClick" MinWidth="110" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfacePanelStyle}" Margin="0,8,0,0" Padding="10">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="AccountText" Text="Not connected" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="AgentText" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Choose an agent or a set on the left. Viewing a loadout does not equip it." />
                </StackPanel>
                <CheckBox x:Name="AutoApply" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Content="Apply saved loadout in agent select"
                          Checked="OnAutoApplyChanged" Unchecked="OnAutoApplyChanged" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfacePanelStyle}" Margin="0,0,8,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="AGENTS" Margin="2,0,0,8" FontSize="13"
                               FontWeight="SemiBold" Foreground="#C8D0DC" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="SETS" Margin="2,0,0,6" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#C8D0DC" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Update" MinWidth="68" Padding="8,2" Margin="0,0,6,0"
                                    Click="OnUpdateSetClick" />
                            <Button Content="Apply" MinWidth="68" Padding="8,2" Margin="0,0,6,0"
                                    Click="OnApplySetClick" />
                            <Button Content="Remove" MinWidth="68" Padding="8,2" Click="OnRemoveSetClick" />
                        </StackPanel>
                        <ListBox x:Name="SetList" MaxHeight="180" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="OnSetChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="2,4" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <ListBox x:Name="AgentList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="OnAgentChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" Height="118" CornerRadius="4"
                                                    Background="#14181F" BorderBrush="#2A3140" BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="#F4F4F4" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF4655" />
                                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ClipToBounds="True">
                                    <Image Stretch="Uniform" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Source="{Binding Portrait}">
                                        <Image.RenderTransform>
                                            <TranslateTransform X="-6" />
                                        </Image.RenderTransform>
                                    </Image>
                                    <Viewbox Width="46" Height="46" Visibility="{Binding RandomMarkVisibility}">
                                        <Canvas Width="64" Height="64">
                                            <Rectangle Canvas.Left="6" Canvas.Top="6" Width="52" Height="52" RadiusX="8" RadiusY="8"
                                                       Fill="#1F232B" Stroke="#F5F5F5" StrokeThickness="3" />
                                            <Ellipse Canvas.Left="16" Canvas.Top="16" Width="8" Height="8" Fill="#F5F5F5" />
                                            <Ellipse Canvas.Left="28" Canvas.Top="28" Width="8" Height="8" Fill="#F5F5F5" />
                                            <Ellipse Canvas.Left="40" Canvas.Top="40" Width="8" Height="8" Fill="#F5F5F5" />
                                        </Canvas>
                                    </Viewbox>
                                    <Border VerticalAlignment="Bottom" Background="#C0101216" Padding="4,3">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="White" TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ItemsControl x:Name="ColumnList" Grid.Column="1" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,10,0" HorizontalAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding Sections}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Title}" Margin="2,0,0,6" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#C8D0DC" />
                                            <ItemsControl ItemsSource="{Binding Weapons}" HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,0,8,8" Padding="0" HorizontalContentAlignment="Stretch"
                                                                HorizontalAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Click="OnWeaponClick" Tag="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Card" MinHeight="132" Background="#1B2333"
                                                                            BorderBrush="#31405C" BorderThickness="1">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#F4F4F4" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                    <Image Margin="10,8,10,24" Stretch="Uniform"
                                                                           Source="{Binding PreviewIcon}" />
                                                                    <Viewbox Width="28" Height="28" VerticalAlignment="Center"
                                                                             Visibility="{Binding EmptyIconVisibility}">
                                                                        <Canvas Width="64" Height="64">
                                                                            <Rectangle Canvas.Left="8" Canvas.Top="8" Width="48" Height="48"
                                                                                       RadiusX="6" RadiusY="6" Fill="Transparent"
                                                                                       Stroke="#D7DEE8" StrokeThickness="3" />
                                                                            <Ellipse Canvas.Left="18" Canvas.Top="18" Width="7" Height="7" Fill="#D7DEE8" />
                                                                            <Ellipse Canvas.Left="29" Canvas.Top="29" Width="7" Height="7" Fill="#D7DEE8" />
                                                                            <Ellipse Canvas.Left="40" Canvas.Top="40" Width="7" Height="7" Fill="#D7DEE8" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <DockPanel Margin="7,0,7,5" VerticalAlignment="Bottom">
                                                                        <Border DockPanel.Dock="Right" Width="14" Height="14" Margin="4,0,0,0"
                                                                                CornerRadius="7" BorderBrush="#8E96A3" BorderThickness="1"
                                                                                Visibility="{Binding ChromaVisibility}">
                                                                            <Image Stretch="UniformToFill" Source="{Binding ChromaIcon}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding WeaponName}" FontSize="10"
                                                                                   Foreground="#AEB8C8" TextTrimming="CharacterEllipsis" />
                                                                    </DockPanel>
                                                                </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Popup x:Name="SkinPopup" Placement="Center" PlacementTarget="{Binding ElementName=ColumnList}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="760" MaxHeight="560" Background="#10151E" BorderBrush="#31405C"
                    BorderThickness="1" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Close" MinWidth="80" Click="OnCloseSkinsClick" />
                        <TextBlock x:Name="SkinPopupTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SkinGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="236" Height="108" Margin="0,0,8,8" Padding="0"
                                            HorizontalContentAlignment="Stretch" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand" Click="OnSkinCardClick" Tag="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" Background="#1B2333" BorderBrush="#31405C"
                                                        BorderThickness="1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#F4F4F4" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                                <Image Margin="12,8,12,26" Stretch="Uniform" Source="{Binding Icon}" />
                                                <Viewbox Width="30" Height="30" VerticalAlignment="Center"
                                                         Visibility="{Binding EmptyIconVisibility}">
                                                    <Canvas Width="64" Height="64">
                                                        <Rectangle Canvas.Left="8" Canvas.Top="8" Width="48" Height="48"
                                                                   RadiusX="6" RadiusY="6" Fill="Transparent"
                                                                   Stroke="#D7DEE8" StrokeThickness="3" />
                                                        <Ellipse Canvas.Left="18" Canvas.Top="18" Width="7" Height="7" Fill="#D7DEE8" />
                                                        <Ellipse Canvas.Left="29" Canvas.Top="29" Width="7" Height="7" Fill="#D7DEE8" />
                                                        <Ellipse Canvas.Left="40" Canvas.Top="40" Width="7" Height="7" Fill="#D7DEE8" />
                                                    </Canvas>
                                                </Viewbox>
                                                <DockPanel Margin="8,0,8,6" VerticalAlignment="Bottom">
                                                    <Border DockPanel.Dock="Right" Width="14" Height="14" Margin="6,0,0,0"
                                                            CornerRadius="7" BorderBrush="#8E96A3" BorderThickness="1"
                                                            Visibility="{Binding ChromaSwatchVisibility}">
                                                        <Image Stretch="UniformToFill" Source="{Binding ChromaSwatch}" />
                                                    </Border>
                                                    <TextBlock FontSize="11" Foreground="#AEB8C8" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="{Binding Variant, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />
    </Grid>
</Page>
