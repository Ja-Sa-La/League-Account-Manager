<Page x:Class="League_Account_Manager.views.ChampionBuyer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="749" d:DesignWidth="1216"
      Title="ChampionBuyer">

    <Grid Background="Transparent" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Style="{StaticResource SurfacePanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                  <StackPanel>
                      <TextBlock Text="Champion buyer" Style="{StaticResource PageTitleStyle}" />
                      <TextBlock Text="Select champions to purchase with Blue Essence."
                           Style="{StaticResource PageSubtitleStyle}" />
                  </StackPanel>
                <Label Name="StatusMessageLabel" Grid.Column="1" Content="Currently buying: "
                      VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0" />
                  <ui:Button Grid.Column="2" Click="OnBuySelectedChampionsClick"
                          ContentControl.Content="Buy selected champions" MinWidth="190" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,12,12,0" Style="{StaticResource SurfacePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Buy log" Style="{StaticResource SectionTitleStyle}" />
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock x:Name="BuyLog" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource SurfacePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Available champions" Style="{StaticResource SectionTitleStyle}" />
                <ListBox Name="BuyableChampionsList" Grid.Row="1" Margin="0,8,0,0"
                         SelectionMode="Multiple" Padding="4" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                         Background="{StaticResource SurfaceBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal" ItemWidth="196" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                            CornerRadius="6" Background="{StaticResource SurfaceRaisedBrush}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Padding="8" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="4" ClipToBounds="True"
                                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Price}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Page>