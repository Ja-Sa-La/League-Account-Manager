<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="League_Account_Manager.views.AddAccounts"
    mc:Ignorable="d"
    d:DesignHeight="749" d:DesignWidth="1216"
    Title="AddAccounts">

    <Grid Background="Transparent" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Style="{StaticResource SurfacePanelStyle}">
            <StackPanel>
                <TextBlock Text="Add accounts" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Add one account manually or import a credential list."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,12,7,0" Style="{StaticResource SurfacePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Single account" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="Username" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <ui:TextBox x:Name="Username" MaxLines="1" />
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="Password" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <ui:PasswordBox x:Name="Password" MaxLines="1" />
                </StackPanel>
                <ui:Button Grid.Row="3" Margin="0,16,0,0" Content="Add account" MinWidth="140"
                           HorizontalAlignment="Left"
                           Click="OnAddSingleAccountClick" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="7,12,0,0" Style="{StaticResource SurfacePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Bulk import" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Grid.Row="1" Text="Paste one username:password pair per line."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,8" TextWrapping="Wrap" />
                <ui:TextBox Grid.Row="2" x:Name="BulkInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                            VerticalScrollBarVisibility="Auto"
                            Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextPrimaryBrush}" />
                <ui:Button Grid.Row="3" Margin="0,12,0,0" Content="Add all" MinWidth="140"
                           HorizontalAlignment="Left"
                           Click="OnAddBulkAccountsClick" />
            </Grid>
        </Border>

    </Grid>
</Page>