<Page

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="League_Account_Manager.views.Accounts"
    mc:Ignorable="d"
    d:DesignHeight="749" d:DesignWidth="1216"
    Title="Accounts" KeyUp="Accounts_OnKeyDown" KeyDown="Accounts_OnKeyDown"
    PreviewKeyDown="Accounts_OnPreviewKeyDown" Loaded="Accounts_OnLoaded" SizeChanged="Accounts_OnSizeChanged"
    ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <Grid Margin="18" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Accounts" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Manage credentials, launch sessions, and inspect account inventory."
                                   Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" x:Name="FilterTextBox"
                                PlaceholderText="Champion, skin, loot or server name"
                                TextWrapping="NoWrap" Padding="10,7" FontSize="12"
                                TextChanged="OnFilterTextChanged" VerticalAlignment="Center" />
                </Grid>
                <Separator Grid.Row="1" Margin="0,16,0,12" Background="{StaticResource StrokeBrush}" />
                <WrapPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Margin="0,0,20,8">
                        <TextBlock Text="SESSION" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,0" x:Name="openleague1" Content="Open League"
                                       Click="OnOpenLeagueClick" MinWidth="116" />
                            <ui:Button Margin="0,0,8,0" x:Name="Login" Content="Login"
                                       Click="OnLoginClick" MinWidth="100" />
                            <ui:Button Margin="0,0,8,0" x:Name="DebugLogin" Content="Debug mode login"
                                       Click="OnLoginClick" MinWidth="108" />
                            <ui:Button Margin="0,0,8,0" x:Name="Stealthlogin" Content="Stealth login"
                                       Click="OnLoginClick" MinWidth="116" />
                            <ui:Button Margin="0,0,8,0" x:Name="SecondaryClient" Content="Second client"
                                       Click="OnSecondaryClientClick" MinWidth="116" />
                            <ui:Button x:Name="killleague" Content="Kill client"
                                       Click="OnKillClientClick" MinWidth="104" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,8">
                        <TextBlock Text="DATA" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ui:Button x:Name="PullData" Content="Pull data"
                                   Click="OnPullDataClick" MinWidth="108" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,8">
                        <TextBlock Text="TOKENS" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,0" x:Name="GenerateLoginToken" Content="Generate token"
                                       Click="GenerateLoginToken_OnClick" MinWidth="120" />
                            <ui:Button x:Name="UseLoginToken" Content="Login with token"
                                       Click="UseLoginToken_OnClick" MinWidth="124" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="ACCOUNT" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,0" x:Name="openleague1_Copy" Content="Name change"
                                       Click="OnNameChangeClick" MinWidth="112" />
                            <ui:Button Margin="0,0,8,0" x:Name="DuplicateRemover" Content="Remove duplicates"
                                       Click="OnRemoveDuplicatesClick" MinWidth="132" />
                            <ui:Button x:Name="Delete" Content="Delete"
                                       Click="OnDeleteClick" MinWidth="90" />
                        </WrapPanel>
                    </StackPanel>
                </WrapPanel>
                
                <Border x:Name="RankProgressPanel" Grid.Row="3" Padding="10,8"
                        Background="{StaticResource SubtleOverlayBrush}" CornerRadius="5"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                     Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Updating ranks" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar x:Name="RankProgressBar" Grid.Column="1" Height="5" Minimum="0"
                                     VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"
                                     Background="{StaticResource StrokeBrush}" />
                        <TextBlock x:Name="RankProgressStatus" Grid.Column="2" Margin="12,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <TextBlock x:Name="RankProgressPercent" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       Margin="0,0,12,0" />
                            <ui:Button x:Name="RankProgressCancel" Content="Cancel"
                                       Click="CancelAccountOperation_Click" MinWidth="64" Padding="8,4" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource SurfacePanelStyle}" Padding="0">
            <DataGrid x:Name="AccountsDataGrid" SelectionUnit="FullRow"
                          KeyDown="Accounts_OnKeyDown"
                          MouseLeftButtonDown="OnAccountsMouseLeftButtonDown"
                          ContextMenuOpening="Accounts_ContextMenuOpening"
                          Sorting="OnAccountsDataGridSorting"
                          IsReadOnly="True"
                          HorizontalContentAlignment="Stretch" AutoGenerateColumns="False"
                          SelectionMode="Single" Margin="0" MinHeight="0"
                          HorizontalAlignment="Stretch" Width="Auto"
                          PreviewMouseWheel="AccountsDataGrid_OnPreviewMouseWheel"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Visible">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy data">
                                <MenuItem Header="Username" Click="AccountsContextCopyUsername_Click" />
                                <MenuItem Header="Password" Click="AccountsContextCopyPassword_Click" />
                                <MenuItem Header="Username:Password" Click="AccountsContextCopyCredentials_Click" />
                                <Separator />
                                <MenuItem Header="Basic details">
                                    <MenuItem Header="League">
                                        <MenuItem Header="Formatted" Click="AccountsContextCopyBasicLeagueFormatted_Click" />
                                        <MenuItem Header="Simple string" Click="AccountsContextCopyBasicLeagueSimple_Click" />
                                    </MenuItem>
                                    <MenuItem Header="VALORANT">
                                        <MenuItem Header="Formatted" Click="AccountsContextCopyBasicValorantFormatted_Click" />
                                        <MenuItem Header="Simple string" Click="AccountsContextCopyBasicValorantSimple_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Both">
                                        <MenuItem Header="Formatted" Click="AccountsContextCopyBasicBothFormatted_Click" />
                                        <MenuItem Header="Simple string" Click="AccountsContextCopyBasicBothSimple_Click" />
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="Full details">
                                    <MenuItem Header="League">
                                        <MenuItem Header="Formatted" Click="AccountsContextCopyFullLeagueFormatted_Click" />
                                        <MenuItem Header="Simple string" Click="AccountsContextCopyFullLeagueSimple_Click" />
                                    </MenuItem>
                                    <MenuItem Header="VALORANT">
                                        <MenuItem Header="Formatted" Click="AccountsContextCopyFullValorantFormatted_Click" />
                                        <MenuItem Header="Simple string" Click="AccountsContextCopyFullValorantSimple_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Both">
                                        <MenuItem Header="Formatted" Click="AccountsContextCopyFullBothFormatted_Click" />
                                        <MenuItem Header="Simple string" Click="AccountsContextCopyFullBothSimple_Click" />
                                    </MenuItem>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="Lookups">
                                <MenuItem Header="OP.GG" Click="AccountsContextOpenOpGg_Click" />
                                <MenuItem Header="League of Graphs" Click="AccountsContextOpenLeagueOfGraphs_Click" />
                                <MenuItem Header="VALORANT Tracker" Click="AccountsContextOpenValorantTracker_Click" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Login" Click="AccountsContextLogin_Click" />
                            <MenuItem Header="Debug mode login" Click="AccountsContextDebugLogin_Click" />
                            <MenuItem Header="Stealth login" Click="AccountsContextStealthLogin_Click" />
                            <Separator />
                            <MenuItem Header="Generate login token" Click="AccountsContextGenerateToken_Click" />
                            <MenuItem Header="Delete account" Click="AccountsContextDelete_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn MaxWidth="220" Header="Username" Width="*" Binding="{Binding username}" />
                        <DataGridTextColumn MaxWidth="250" Header="Password" Width="*" Binding="{Binding password}" />
                        <DataGridTextColumn MaxWidth="250" Header="RiotID" Width="*" Binding="{Binding riotID}" />
                        <DataGridTextColumn MinWidth="50" Header="Level" Binding="{Binding level}" />
                        <DataGridTextColumn MinWidth="50" Header="Server" Binding="{Binding server}" />
                        <DataGridTextColumn MinWidth="50" Header="BE" Binding="{Binding be}" />
                        <DataGridTextColumn MinWidth="50" Header="RP" Binding="{Binding rp}" />
                        <DataGridTextColumn MinWidth="50" Header="SoloQ" Binding="{Binding rank}" />
                        <DataGridTextColumn MinWidth="50" Header="FlexQ" Binding="{Binding rank2}" />
                        <DataGridTextColumn MinWidth="140" Header="Last Played" Binding="{Binding lastPlayed}" />
                        <DataGridTextColumn MinWidth="50" Header="Champions" Binding="{Binding Champions}" />
                        <DataGridTextColumn MinWidth="50" Header="Skins" Binding="{Binding Skins}" />
                        <DataGridTextColumn MinWidth="50" Header="Loot" Binding="{Binding Loots}" />
                        <DataGridTextColumn MinWidth="50" Header="Notes">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Open" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource AppDataGridCellStyle}" />
                        <Style TargetType="ScrollBar">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource StrokeBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Track x:Name="PART_Track">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                  Background="Transparent" BorderThickness="0"
                                                                  IsTabStop="False" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Background="{TemplateBinding Foreground}"
                                                           BorderBrush="Transparent" BorderThickness="0" />
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                  Background="Transparent" BorderThickness="0"
                                                                  IsTabStop="False" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Orientation" Value="Horizontal">
                                                <Setter TargetName="PART_Track" Property="Height" Value="6" />
                                                <Setter TargetName="PART_Track" Property="VerticalAlignment" Value="Center" />
                                            </Trigger>
                                            <Trigger Property="Orientation" Value="Vertical">
                                                <Setter TargetName="PART_Track" Property="Width" Value="6" />
                                                <Setter TargetName="PART_Track" Property="HorizontalAlignment" Value="Center" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Height" Value="10" />
                                </Trigger>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="10" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                        </Style>

                    </DataGrid.Resources>
                </DataGrid>
            </Border>
        </Grid>

        <Grid x:Name="Progressgrid" Grid.RowSpan="2" Panel.ZIndex="20" Visibility="Collapsed"
              Background="Transparent">
                <Border Background="{StaticResource OverlayBrush}" />
                <Border Width="480" MaxHeight="520" Style="{StaticResource ModalPanelStyle}" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="ACCOUNT ACTIVITY" Foreground="{StaticResource SuccessBrush}" FontSize="10"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="AccountOperationTitle" Margin="0,6,0,0"
                                   Text="Pulling account data" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="AccountOperationStatus" Margin="0,6,0,0"
                                   Text="Preparing..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" Height="48" Margin="0,20,0,16">
                        <Canvas Width="40" Height="40" HorizontalAlignment="Center">
                            <Ellipse Width="36" Height="36" Stroke="{StaticResource SuccessBrush}" StrokeThickness="3"
                                     StrokeDashArray="3 2" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <Border Grid.Row="2" Padding="12,10" Background="{StaticResource SubtleOverlayBrush}" CornerRadius="6">
                        <ListBox x:Name="TaskListBox" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 Padding="2" FontSize="12.5">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Padding" Value="2,0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <ui:Button x:Name="CancelAccountOperationButton" Grid.Row="3" Content="Cancel"
                               Click="CancelAccountOperation_Click" HorizontalAlignment="Right"
                               MinWidth="100" Margin="0,20,0,0" Padding="12,8" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>