<Page x:Class="League_Account_Manager.views.DiscordPresence"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="749" d:DesignWidth="1216"
      Title="Discord">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Discord" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Choose the live match details and optional account stats shown while League or Valorant is open."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Presence" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                            <CheckBox x:Name="Enabled" Content="Show League and Valorant on Discord"
                                                                  Click="OnSettingChanged" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Both games can appear at the same time. Discord must stay open, and each activity remains visible only while this application stays open. Passwords are never included." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SurfacePanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Visible details" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                            <CheckBox x:Name="ShowMatch" Content="Queue, map, and selected champion or agent" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowScore" Content="Round score" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowKd" Content="K/D" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowPartyJoin" Content="Valorant party join button" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowRiotId" Content="Riot ID" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowLevel" Content="Account level" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowRegion" Content="Region" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowRank" Content="Rank" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowCurrency" Content="Currencies" Margin="0,0,0,8"
                                                                  Click="OnSettingChanged" />
                            <CheckBox x:Name="ShowCollection" Content="Collection counts" Margin="0,0,0,12"
                                                                  Click="OnSettingChanged" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="The situation is always shown first. Optional stats appear after the match details. Passwords are never included." />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource SurfacePanelStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Preview" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />
                        <Border Background="#1E2124" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="68" Height="68" CornerRadius="8" Background="#0A1220" Margin="0,0,12,0">
                                    <TextBlock Text="LoL" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#C8AA6E" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="League of Legends" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock x:Name="LeaguePreview" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="#B9BBBE" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#1E2124" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="68" Height="68" CornerRadius="8" Background="#120C10" Margin="0,0,12,0">
                                    <TextBlock Text="VAL" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#FF4655" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="VALORANT" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock x:Name="ValorantPreview" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="#B9BBBE" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
