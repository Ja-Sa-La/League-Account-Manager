<Page x:Class="League_Account_Manager.views.ProfileEditor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="749" d:DesignWidth="1216"
      Title="ProfileEditor" Loaded="OnProfileEditorLoaded" Unloaded="OnProfileEditorUnloaded">
    <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Chat and profile" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Manage presence, status message, profile icon, background, and ranked identity."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SurfacePanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Presence" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <ui:Button Content="Disable chat" Margin="0,0,8,8" Click="OnDisableChatClick" />
                            <ui:Button Content="Enable chat" Margin="0,0,0,8" Click="OnEnableChatClick" />
                            <ui:Button Content="Show offline" Margin="0,0,8,8" Click="OnSetChatOfflineClick" />
                            <ui:Button Content="Show away" Margin="0,0,0,8" Click="OnSetChatAwayClick" />
                            <ui:Button Content="Show mobile" Margin="0,0,8,0" Click="OnSetChatMobileClick" />
                            <ui:Button Content="Show online" Click="OnSetChatOnlineClick" />
                        </UniformGrid>
                        <ui:Button Content="Get chat settings" Click="OnGetChatSettingsClick" Visibility="Hidden" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SurfacePanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status message" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                        <ui:TextBox Grid.Row="1" x:Name="StatusMessageContainer" ClearButtonEnabled="False"
                                    PlaceholderText="Status message" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                        <ui:Button Grid.Row="2" Content="Set status message" Margin="0,10,0,0"
                                   HorizontalAlignment="Left" Click="OnSetStatusMessageClick" />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SurfacePanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Profile icon" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                        <ui:AutoSuggestBox x:Name="IconList" IsEnabled="False" PlaceholderText="Loading"
                                           SuggestionChosen="OnIconSuggestionChosen" GotFocus="OnIconListGotFocus">
                            <ui:AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Border Width="28" Height="28" CornerRadius="4" ClipToBounds="True" DockPanel.Dock="Left">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </DockPanel>
                                </DataTemplate>
                            </ui:AutoSuggestBox.ItemTemplate>
                        </ui:AutoSuggestBox>
                        <Border Height="210" Margin="0,10,0,10" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Image x:Name="IconPreview" Stretch="UniformToFill" />
                        </Border>
                        <ui:Button Content="Set icon" HorizontalAlignment="Left" Click="OnSetIconClick" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SurfacePanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Profile background" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                        <ui:AutoSuggestBox x:Name="SkinList" IsEnabled="False" PlaceholderText="Loading"
                                           SuggestionChosen="OnSkinSuggestionChosen" GotFocus="OnIconListGotFocus">
                            <ui:AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Border Width="44" Height="28" CornerRadius="4" ClipToBounds="True" DockPanel.Dock="Left">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </DockPanel>
                                </DataTemplate>
                            </ui:AutoSuggestBox.ItemTemplate>
                        </ui:AutoSuggestBox>
                        <Border Height="210" Margin="0,10,0,10" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Image x:Name="SkinPreview" Stretch="UniformToFill" />
                        </Border>
                        <ui:Button Content="Set background" HorizontalAlignment="Left" Click="OnSetBackgroundClick" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource SurfacePanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Ranked identity" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="Queue" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="Mode" ItemsSource="{Binding QueueList}" MinWidth="220" MinHeight="42"
                                  Padding="12,8" Margin="0,0,0,12" />
                        <TextBlock Text="Rank" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="Rank" ItemsSource="{Binding RankList}" MinWidth="220" MinHeight="42"
                                  Padding="12,8" Margin="0,0,0,12" />
                        <TextBlock Text="Division" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="Division" ItemsSource="{Binding TierList}" MinWidth="220" MinHeight="42"
                                  Padding="12,8" Margin="0,0,0,16" />
                        <ui:Button Content="Set rank" HorizontalAlignment="Left" Click="OnSetRankClick" />
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>
</Page>
