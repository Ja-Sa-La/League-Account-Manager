<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="League_Account_Manager.views.Settings"
    mc:Ignorable="d"
    d:DesignHeight="749" d:DesignWidth="1216"
    Title="Settings">

       <Grid Margin="18">
              <Grid.RowDefinitions>
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="*" />
                     <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,16">
                     <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                     <TextBlock Text="Manage updates, account storage, privacy, and installation options."
                                      Style="{StaticResource PageSubtitleStyle}" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <Grid>
                            <Grid.ColumnDefinitions>
                                   <ColumnDefinition Width="*" />
                                   <ColumnDefinition Width="14" />
                                   <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                   <Border Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,14">
                                          <StackPanel>
                                                 <TextBlock Text="Updates" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                                 <CheckBox Name="savesettingsupdates" Content="Check for updates automatically" Margin="0,0,0,12" />
                                                 <TextBlock Text="Release channel" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                                 <ComboBox x:Name="ReleaseChannel" SelectedIndex="0">
                                                        <ComboBoxItem Content="Stable — Tested releases only" />
                                                        <ComboBoxItem Content="Beta — Early access to new features (may have bugs)" />
                                                 </ComboBox>
                                          </StackPanel>
                                   </Border>
                                   <Border Style="{StaticResource SurfacePanelStyle}">
                                          <StackPanel>
                                                 <TextBlock Text="Account data" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                                 <TextBlock Text="Save file name" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                                 <ui:TextBox Name="settingssaveinfobox" TextWrapping="Wrap" Margin="0,0,0,12" />
                                                 <CheckBox x:Name="DisplayPasswords" Content="Display passwords in the accounts view" Margin="0,0,0,7" />
                                                 <CheckBox x:Name="AutoUpdateRanks" Content="Update ranks automatically on startup" Margin="0,0,0,7" />
                                                 <TextBlock Text="Persist login (Remember Me)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                                 <ComboBox x:Name="PersistentLoginMode" SelectedIndex="0" Margin="0,0,0,7">
                                                        <ComboBoxItem Content="Ask every time" />
                                                        <ComboBoxItem Content="Always — allow staying logged in" />
                                                        <ComboBoxItem Content="Never — do not stay logged in" />
                                                 </ComboBox>
                                                 <CheckBox x:Name="UseLegacyLogin" Content="Use legacy login" Margin="0,0,0,7"
                                                           ToolTip="Log in by typing the credentials into the Riot Client window (browser automation) instead of the RSO API. Enable this only if the standard login has issues with your accounts."
                                                           IsChecked="False" />
                                                 <CheckBox x:Name="AccountFileEncryption" Content="Encrypt the account file with a password"
                                                                 Checked="OnAccountFileEncryptionChecked" Unchecked="OnAccountFileEncryptionChecked" />
                                                 <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                        <ui:Button Content="Import accounts" Margin="0,0,8,0" Click="OnImportAccountsClick" />
                                                        <ui:Button Content="Export accounts" Click="OnExportAccountsClick" />
                                                 </StackPanel>
                                          </StackPanel>
                                   </Border>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource SurfacePanelStyle}" VerticalAlignment="Top">
                                   <StackPanel>
                                          <TextBlock Text="Installation" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                          <TextBlock Text="Current location" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                          <TextBox x:Name="CurrentInstallLocation" TextWrapping="Wrap" IsReadOnly="True"
                                                         Padding="10" MinHeight="58" Background="{StaticResource SurfaceRaisedBrush}"
                                                         BorderBrush="{StaticResource StrokeBrush}" Foreground="{StaticResource TextPrimaryBrush}" />
                                          <ui:Button Content="Move installation" Margin="0,14,0,0" HorizontalAlignment="Left"
                                                           Click="OnMoveInstallationClick" />
                                          <Separator Margin="0,20,0,16" />
                                          <TextBlock Text="Cloud account sync" Style="{StaticResource SectionTitleStyle}" />
                                          <TextBlock x:Name="CloudStatus" Text="Not signed in" TextWrapping="Wrap" Margin="0,10,0,10" Foreground="{StaticResource TextSecondaryBrush}" />
                                          <StackPanel x:Name="CloudActions">
                                                 <ui:Button x:Name="CloudSignIn" Content="Sign in / Create account" Click="OnCloudSignInClick" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                                 <TextBlock Text="Accounts" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6" />
                                                 <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <ui:Button x:Name="CloudUpload" Content="Upload accounts" Click="OnCloudUploadClick" Margin="0,0,8,0" />
                                                        <ui:Button x:Name="CloudDownload" Content="Download accounts" Click="OnCloudDownloadClick" />
                                                 </StackPanel>
                                                 <TextBlock Text="Settings" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                 <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <ui:Button x:Name="CloudUploadSettings" Content="Upload settings" Click="OnCloudUploadSettingsClick" Margin="0,0,8,0" />
                                                        <ui:Button x:Name="CloudDownloadSettings" Content="Download settings" Click="OnCloudDownloadSettingsClick" />
                                                 </StackPanel>
                                                 <ui:Button x:Name="CloudLogout" Content="Sign out" Click="OnCloudLogoutClick" HorizontalAlignment="Left" />
                                                 <Separator Margin="0,20,0,16" />
                                                 <TextBlock Text="Plugins" Style="{StaticResource SectionTitleStyle}" />
                                                 <TextBlock x:Name="PluginStatusSummary" TextWrapping="Wrap" Margin="0,10,0,8"
                                                            Foreground="{StaticResource TextSecondaryBrush}" />
                                                 <ItemsControl x:Name="PluginStatusList">
                                                        <ItemsControl.ItemTemplate>
                                                               <DataTemplate>
                                                                      <StackPanel>
                                                                      <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                                IsEnabled="{Binding CanToggle}" Tag="{Binding}" Checked="OnPluginEnabledChanged"
                                                                                Unchecked="OnPluginEnabledChanged" Margin="0,2,0,2" />
                                                                      <TextBlock Text="{Binding State}" Margin="20,0,0,2" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                      <TextBlock Text="{Binding Details}" Margin="20,0,0,4" TextWrapping="Wrap"
                                                                                 Foreground="{StaticResource TextSecondaryBrush}" />
                                                                      </StackPanel>
                                                               </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                 </ItemsControl>
                                                 <TextBlock Text="Plugin changes apply after restarting the application. Plugins are trusted in-process code."
                                                            TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                          </StackPanel>
                                   </StackPanel>
                            </Border>
              </Grid>
              </ScrollViewer>
              <ui:Button Grid.Row="2" Content="Save settings" Margin="0,16,0,0" HorizontalAlignment="Right"
                               MinWidth="140" Click="OnSaveSettingsClick" />
       </Grid>
</Page>