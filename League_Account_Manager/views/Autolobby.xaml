<Page x:Class="League_Account_Manager.views.Autolobby"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

      mc:Ignorable="d"
      d:DesignHeight="749" d:DesignWidth="1216"
      Title="Autolobby">

       <Grid Margin="18">
                     <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                     </Grid.RowDefinitions>
                     <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Auto champion select" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Configure queue actions, role picks, bans, and champion-select messaging."
                                             Style="{StaticResource PageSubtitleStyle}" />
                     </StackPanel>
                     <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                   <ColumnDefinition Width="*" />
                                   <ColumnDefinition Width="12" />
                                   <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfacePanelStyle}">
                                   <StackPanel>
                                          <TextBlock Text="Automation" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                          <UniformGrid Columns="2">
                                                 <Button Content="Enable AutoAcceptQueue" Margin="0,0,8,8" Click="OnToggleAutoAcceptClick" />
                                                 <Button Content="Enable AutoMuteAll" Margin="0,0,0,8" Click="OnToggleAutoMuteClick"
                                                               ToolTip="Mutes every teammate in champion select chat automatically" />
                                                 <Button Content="Enable AutoAcceptPick" Margin="0,0,8,0" Click="OnToggleAutoPickClick" />
                                                 <Button Content="Enable AutoAcceptBan" Click="OnToggleAutoBanClick" />
                                          </UniformGrid>
                                          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                 <CheckBox x:Name="InstantPick" Content="Instant pick" IsChecked="True" Margin="0,0,24,0"
                                                                 ToolTip="Lock the selected champion as soon as your pick action starts" />
                                                 <CheckBox x:Name="InstantBan" Content="Instant ban"
                                                                 ToolTip="Lock the selected ban as soon as your ban action starts" />
                                          </StackPanel>
                                   </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SurfacePanelStyle}">
                                   <Grid>
                                          <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="*" />
                                          </Grid.RowDefinitions>
                                          <Button Content="Enable AutoAcceptMessage" Click="OnToggleAutoMessageClick" Margin="0,0,0,10" />
                                          <ui:TextBox Grid.Row="1" ClearButtonEnabled="False" PlaceholderText="Champion-select message"
                                                               AcceptsReturn="True" TextWrapping="Wrap" Name="MessageContainer" MinHeight="76" />
                                   </Grid>
                            </Border>
                     </Grid>
                     <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                   <ColumnDefinition Width="2*" />
                                   <ColumnDefinition Width="12" />
                                   <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfacePanelStyle}">
                                   <Grid>
                                          <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                          </Grid.RowDefinitions>
                                          <TextBlock Text="Preferred picks" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />
                                          <Grid Grid.Row="1">
                                                 <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                 </Grid.ColumnDefinitions>
                                                 <StackPanel>
                                                        <TextBlock x:Name="blindPickLabel" Text="Blind / No role" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ui:AutoSuggestBox x:Name="blindPickChampion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,14" />
                                                        <TextBlock x:Name="topPickLabel" Text="Top" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ui:AutoSuggestBox x:Name="topPickChampion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,14" />
                                                        <TextBlock x:Name="junglePickLabel" Text="Jungle" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ui:AutoSuggestBox x:Name="junglePickChampion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,0" />
                                                 </StackPanel>
                                                 <StackPanel Grid.Column="2">
                                                        <TextBlock x:Name="midPickLabel" Text="Mid" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ui:AutoSuggestBox x:Name="midPickChampion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,14" />
                                                        <TextBlock x:Name="botPickLabel" Text="Bot" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ui:AutoSuggestBox x:Name="botPickChampion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,14" />
                                                        <TextBlock x:Name="supportPickLabel" Text="Support" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ui:AutoSuggestBox x:Name="supportPickChampion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,0" />
                                                 </StackPanel>
                                          </Grid>
                                   </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SurfacePanelStyle}">
                                   <StackPanel>
                                          <TextBlock Text="Ban priority" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />
                                          <TextBlock x:Name="ban1Label" Text="Ban 1" Foreground="{StaticResource TextSecondaryBrush}" />
                                          <ui:AutoSuggestBox x:Name="ban1Champion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,14" />
                                          <TextBlock x:Name="ban2Label" Text="Ban 2" Foreground="{StaticResource TextSecondaryBrush}" />
                                          <ui:AutoSuggestBox x:Name="ban2Champion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,14" />
                                          <TextBlock x:Name="ban3Label" Text="Ban 3" Foreground="{StaticResource TextSecondaryBrush}" />
                                          <ui:AutoSuggestBox x:Name="ban3Champion" PlaceholderText="Select champion" DisplayMemberPath="Name" Margin="0,5,0,0" />
                                   </StackPanel>
                            </Border>
                     </Grid>
       </Grid>
</Page>