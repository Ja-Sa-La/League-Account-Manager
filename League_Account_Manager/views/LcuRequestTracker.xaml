<Page x:Class="League_Account_Manager.views.LcuRequestTracker"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="749" d:DesignWidth="1216"
      Title="LCU Request Tracker">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="LCU traffic" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="StatusText" Text="Waiting for traffic" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <ui:TextBox Grid.Column="1" x:Name="SearchText" PlaceholderText="Filter endpoint or payload"
                        TextChanged="SearchText_OnTextChanged" Margin="6,0" />
            <ComboBox Grid.Column="2" x:Name="TrafficTypeFilter" SelectionChanged="TrafficTypeFilter_OnSelectionChanged"
                      SelectedIndex="0" Margin="6,0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="All traffic" Tag="All" />
                <ComboBoxItem Content="REST" Tag="REST" />
                <ComboBoxItem Content="WebSocket" Tag="WebSocket" />
                <ComboBoxItem Content="HTTP" Tag="HTTP" />
                <ComboBoxItem Content="XMPP" Tag="XMPP" />
                <ComboBoxItem Content="RMS" Tag="RMS" />
                <ComboBoxItem Content="RTMP" Tag="RTMP" />
            </ComboBox>
            <ComboBox Grid.Column="3" x:Name="DirectionFilter" SelectionChanged="DirectionFilter_OnSelectionChanged"
                      SelectedIndex="0" Margin="6,0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="All directions" Tag="All" />
                <ComboBoxItem Content="Incoming" Tag="Incoming" />
                <ComboBoxItem Content="Outgoing" Tag="Outgoing" />
            </ComboBox>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <ui:Button Content="Select all" Click="SelectAll_OnClick" Margin="4,0" />
                <ui:Button Content="Export selected" Click="ExportSelected_OnClick" Margin="4,0" />
                <ui:Button Content="Clear" Click="Clear_OnClick" Margin="4,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CustomTarget" SelectedIndex="0" Margin="0,0,6,0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="League LCU" Tag="league" />
                <ComboBoxItem Content="Riot Client" Tag="riot" />
            </ComboBox>
            <ComboBox Grid.Column="1" x:Name="CustomMethod" SelectedIndex="0" Margin="0,0,6,0"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="GET" />
                <ComboBoxItem Content="POST" />
                <ComboBoxItem Content="PUT" />
                <ComboBoxItem Content="PATCH" />
                <ComboBoxItem Content="DELETE" />
            </ComboBox>
            <ui:TextBox Grid.Column="2" x:Name="CustomEndpoint" PlaceholderText="/lol-endpoint/v1/resource"
                        Margin="0,0,6,0" />
            <ui:TextBox Grid.Column="3" x:Name="CustomBody" PlaceholderText="JSON request body" Margin="0,0,6,0" />
            <ui:Button Grid.Column="4" Content="Load selected" Click="LoadSelectedRequest_OnClick" Margin="0,0,6,0" />
            <ui:Button Grid.Column="5" Content="Send request" Click="SendCustomRequest_OnClick" />
        </Grid>

        <DataGrid Grid.Row="2" x:Name="TrafficGrid" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionChanged="TrafficGrid_OnSelectionChanged"
                  Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Export" Width="65" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Time" Width="95" Binding="{Binding Time}" IsReadOnly="True" />
                <DataGridTextColumn Header="Type" Width="90" Binding="{Binding Record.TrafficType}" IsReadOnly="True" />
                <DataGridTextColumn Header="Direction" Width="85" Binding="{Binding Record.Direction}" IsReadOnly="True" />
                <DataGridTextColumn Header="Target" Width="75" Binding="{Binding Record.Target}" IsReadOnly="True" />
                <DataGridTextColumn Header="Method" Width="75" Binding="{Binding Record.Method}" IsReadOnly="True" />
                <DataGridTextColumn Header="Status" Width="115" Binding="{Binding Status}" IsReadOnly="True" />
                <DataGridTextColumn Header="Duration" Width="85" Binding="{Binding Duration}" IsReadOnly="True" />
                <DataGridTextColumn Header="Endpoint / URI" Width="*" Binding="{Binding Record.Endpoint}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="4,0,0,7">
                <ui:Button DockPanel.Dock="Right" Content="Copy" Click="CopyRequest_OnClick" Padding="10,2" />
                <TextBlock Text="Sent data / request" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
            </DockPanel>
            <DockPanel Grid.Column="2" Margin="4,0,0,5">
                <ui:Button DockPanel.Dock="Right" Content="Copy" Click="CopyResponse_OnClick" Padding="10,2" />
                <TextBlock Text="Received data / response" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
            </DockPanel>
            <TextBox Grid.Row="1" x:Name="RequestDetails" IsReadOnly="True" TextWrapping="NoWrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono" Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource StrokeBrush}" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="ResponseDetails" IsReadOnly="True" TextWrapping="NoWrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono" Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource StrokeBrush}" Foreground="{StaticResource TextPrimaryBrush}" />
        </Grid>
    </Grid>
</Page>