<Window x:Class="League_Account_Manager.Windows.PasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account File Password"
        Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        MouseDown="Window_MouseDown"
        Topmost="True">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfacePanelStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Account file password" Style="{StaticResource SectionTitleStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SurfacePanelStyle}" Padding="12" Margin="0,8,0,8">
            <StackPanel>
                <TextBlock x:Name="PromptText"
                           Text="Enter the account file password:"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           FontSize="13" />

                <PasswordBox x:Name="PasswordBox"
                             Background="{StaticResource SurfaceRaisedBrush}"
                             BorderBrush="{StaticResource StrokeBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             Padding="8"
                             FontSize="13" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
                <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>