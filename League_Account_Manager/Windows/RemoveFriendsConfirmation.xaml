<Window x:Class="League_Account_Manager.Windows.RemoveFriendsConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Remove all friends" Width="380" SizeToContent="Height" WindowStyle="None"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Margin="12" Style="{StaticResource SurfacePanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Remove all friends?" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Grid.Row="1" Margin="0,6,0,16" TextWrapping="Wrap"
                       Text="This removes every friend from the current account and cannot be undone."
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="Button_Click1" />
                <ui:Button Content="Remove all" Click="Button_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
