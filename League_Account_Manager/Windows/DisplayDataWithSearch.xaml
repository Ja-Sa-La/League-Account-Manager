<Window x:Class="League_Account_Manager.Windows.DisplayDataWithSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Height="620"
        Width="560" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        MouseDown="Window_MouseDownDatadisplay" Deactivated="Window_Deactivated" ResizeMode="NoResize"
        LocationChanged="Window_LocationOrSizeChanged" SizeChanged="Window_LocationOrSizeChanged"
        Closed="Window_Closed">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfacePanelStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Data viewer" Style="{StaticResource SectionTitleStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SurfacePanelStyle}" Padding="8" Margin="0,8,0,8">
            <ui:TextBox TextAlignment="Left" VerticalContentAlignment="Center"
                        TextWrapping="NoWrap" Name="datafiltersearch" PlaceholderText="Search"
                        TextChanged="TextBox_TextChangeddatafilt" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfacePanelStyle}" Padding="8">
            <ScrollViewer MouseDown="Window_MouseDownDatadisplay"
                          VerticalScrollBarVisibility="Auto" MouseLeave="OnItemsListMouseLeave">
                <ItemsControl Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,8"
                                    MouseEnter="OnItemHoverEnter">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Border Height="60" MinWidth="60" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Image Height="60" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Stretch="Uniform" Source="{Binding IconSource}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                                                   FontSize="16" />
                                        <TextBlock Text="{Binding Price}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>