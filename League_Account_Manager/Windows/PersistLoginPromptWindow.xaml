<Window x:Class="League_Account_Manager.Windows.PersistLoginPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Persist Login"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Width="480" Style="{StaticResource ModalPanelStyle}" Padding="28,24"
            BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="STAY SIGNED IN" Foreground="{StaticResource SuccessBrush}" FontSize="10"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" Text="Persist login" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="PromptText" Margin="0,6,0,0"
                       Text="Allow user to stay logged in?"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />

            <CheckBox x:Name="RememberChoice" Margin="0,20,0,0" Content="Remember this choice"
                      Foreground="{StaticResource TextPrimaryBrush}" />

            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="No" MinWidth="100" Margin="0,0,8,0" Padding="12,8" IsCancel="True"
                           Click="No_Click" />
                <ui:Button Content="Yes" MinWidth="100" Padding="12,8" IsDefault="True" Click="Yes_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
