<Window x:Class="League_Account_Manager.Windows.PersistLoginPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Persist Login"
        Height="230" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        MouseDown="Window_MouseDown"
        Topmost="True">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfacePanelStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Persist login" Style="{StaticResource SectionTitleStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SurfacePanelStyle}" Padding="12" Margin="0,8,0,8">
            <StackPanel>
                <TextBlock x:Name="PromptText"
                           Text="Allow user to stay logged in?"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           FontSize="13" />

                <CheckBox x:Name="RememberChoice"
                          Content="Remember this choice"
                          Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Yes" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Yes_Click" />
            <Button Content="No" Width="90" IsCancel="True" Click="No_Click" />
        </StackPanel>
    </Grid>
</Window>
