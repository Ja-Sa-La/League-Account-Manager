<Window x:Class="League_Account_Manager.views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="250" Height="60"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="12">
        <StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
            <ProgressBar x:Name="ProgressBar" Height="8" Margin="0,9,0,0" Minimum="0" />
        </StackPanel>
    </Border>
</Window>