<Window x:Class="League_Account_Manager.Windows.ChallengeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabasco"
        Height="420" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        Topmost="True">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfacePanelStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Complete the challenge to continue" Style="{StaticResource SectionTitleStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SurfacePanelStyle}" Padding="4" Margin="0,8,0,8">
            <Border x:Name="WebViewHost" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
