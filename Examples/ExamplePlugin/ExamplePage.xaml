<Page x:Class="ExamplePlugin.ExamplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <Border MaxWidth="860"
                Padding="24"
                HorizontalAlignment="Left"
                Background="#20262C"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Example plugin"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Host-mediated League client requests"
                           Margin="0,4,0,20"
                           Opacity="0.75" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CurrentSummonerButton"
                            MinWidth="170"
                            Margin="0,0,10,0"
                            Padding="14,8"
                            Content="Read current summoner"
                            Click="CurrentSummonerButton_Click" />
                    <Button x:Name="StorefrontButton"
                            MinWidth="170"
                            Padding="14,8"
                            Content="Read storefront champions"
                            Click="StorefrontButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Margin="0,18,0,6"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="Ready" />
                <TextBlock x:Name="ResponseText"
                           MaxWidth="760"
                           Text="Choose an action to request data from the running League client."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
